# Copie para .env e preencha. O .env fica fora do Git.
GOOGLE_API_KEY=

# Opcionais (valores padrão entre parênteses)
# Modelo Gemini dos agentes (gemini-3.5-flash)
AURORA_MODEL=
# Banco de sessões do ADK (var/sessions.sqlite3)
AURORA_SESSION_DB=
# Banco de reservas, visitantes e pendências (var/dominio.sqlite3)
AURORA_DOMAIN_DB=
# Pasta com os JSON iniciais (dados/)
AURORA_DADOS_DIR=
# Caminho do regulamento (dados/regulamento.md)
AURORA_REGULAMENTO_PATH=
